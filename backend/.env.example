# Smart Helpdesk backend. Compose passes these to the app, horizon, scheduler and reverb containers.
APP_NAME="Smart Helpdesk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.shp.localhost
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_VERSION=dev
APP_MAINTENANCE_DRIVER=cache

# Hosts (ADR-0021)
PLATFORM_DOMAIN=shp.localhost
HOST_LAYOUT=split
TENANCY_SINGLE_TENANT=

# Logging
LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=debug

# PostgreSQL: runtime role (RLS applies) and owner role (migrations, provisioning)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=helpdesk
DB_USERNAME=helpdesk_app
DB_PASSWORD_FILE=/run/secrets/db_app_password
DB_OWNER_USERNAME=helpdesk_owner
DB_OWNER_PASSWORD_FILE=/run/secrets/db_owner_password

# Sessions and cookies shared by app.* and api.* (ADR-0021)
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_DOMAIN=.shp.localhost
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=shp_session
SANCTUM_STATEFUL_DOMAINS=app.shp.localhost
CORS_ALLOWED_ORIGINS=https://app.shp.localhost

# Valkey (Redis protocol) via phpredis
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_PREFIX=shp_local_
CACHE_STORE=redis
CACHE_PREFIX=shp_local_cache_
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
# Realtime (M3-16, docs/03-architecture/realtime.md). Compose passes BROADCAST_CONNECTION and
# REALTIME_ENABLED from the root .env, so the switch lives there; these are the Reverb credentials.
# REVERB_APP_KEY is public (the browser sends it) and must match REVERB_APP_KEY in the root .env.
REVERB_APP_ID=smart-helpdesk
REVERB_APP_KEY=shp-dev-key
REVERB_APP_SECRET=shp-dev-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Object storage (RustFS in development)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=helpdesk
AWS_SECRET_ACCESS_KEY=helpdesk-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=helpdesk
AWS_ENDPOINT=http://rustfs:9000
AWS_URL=https://files.shp.localhost/helpdesk
AWS_PRESIGN_ENDPOINT=https://files.shp.localhost
AWS_USE_PATH_STYLE_ENDPOINT=true

# Mail (Mailpit in development; the bundled Stalwart server in the `mail` profile)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@shp.localhost"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_RELAY_HOST=
# Mail identity (M3-18): Settings → Email shows these DNS values; mail-init.sh prints the DKIM pair.
MAIL_SPF_INCLUDE=
MAIL_DMARC_POLICY=none
MAIL_DKIM_SELECTOR=
MAIL_DKIM_PUBLIC_KEY=

# Inbound email (M3-19): mail:fetch-inbound reads the catch-all inbound@ mailbox of the bundled server over
# IMAP every minute. Needs the mail profile (just mail-init); the password is MAIL_INBOUND_PASSWORD of the root .env.
MAIL_INBOUND_ENABLED=false
MAIL_INBOUND_HOST=mail
MAIL_INBOUND_PORT=143
MAIL_INBOUND_ENCRYPTION=none
MAIL_INBOUND_USERNAME=inbound@shp.localhost
MAIL_INBOUND_PASSWORD=dev-mail-inbound

# Outbound webhooks (docs/07-api/webhooks.md): host names that skip the https, port and
# private-address checks of the SSRF guard. Development only; ignored when APP_ENV=production.
WEBHOOK_DEV_ALLOWED_HOSTS=webhook-echo

# Demo dataset (roadmap/11-demo-dataset.md): `php artisan demo:reset` rebuilds the acme and globex
# workspaces. Production refuses unless DEMO_INSTANCE=true (a public demo instance) and --force.
DEMO_INSTANCE=false
DEMO_PASSWORD=password
DEMO_HISTORY_TICKETS=180

# Tooling
HORIZON_DOMAIN=monitor.shp.localhost
HORIZON_PATH=horizon
TELESCOPE_ENABLED=true

# Health report at /v1/health: send Authorization: Bearer <HEALTH_TOKEN>. Empty = open in local only.
HEALTH_TOKEN=
HEALTH_NOTIFY_MAIL=
HEALTH_CACHE_STORE=redis
PASSWORD_HASH_ROUNDS=12

# Self sign-up limits (config/helpdesk.php platform.signup_limits); 0 = no limit. Local development and
# demos turn them off; production keeps the defaults (5 and 3 an hour, 30 and 10 a minute).
SIGNUP_LIMIT_PER_IP_HOUR=0
SIGNUP_LIMIT_PER_EMAIL_HOUR=0
SIGNUP_LIMIT_ADDRESS_PER_MINUTE=0
SIGNUP_LIMIT_VERIFY_PER_MINUTE=0
