<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Contracts">
            <directory>tests/Contracts</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Tenancy isolation proof (docs/10-quality/testing.md); a failure here blocks merge. -->
        <testsuite name="Permissions">
            <directory>tests/Permissions</directory>
        </testsuite>
        <testsuite name="Isolation">
            <directory>tests/Isolation</directory>
        </testsuite>
        <!-- Group `performance` is excluded below, so a plain run skips this suite; the command is in the test file. -->
        <testsuite name="Performance">
            <directory>tests/Performance</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>performance</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- One process runs about 1 200 tests; PHP's default 256M runs out near the end of the suite. -->
        <ini name="memory_limit" value="1G"/>
        <!-- <server> because Laravel reads $_SERVER first and Compose injects backend/.env into the container. -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_URL" value="https://api.shp.localhost" force="true"/>
        <server name="PLATFORM_DOMAIN" value="shp.localhost" force="true"/>
        <server name="HOST_LAYOUT" value="split" force="true"/>
        <server name="SESSION_DOMAIN" value=".shp.localhost" force="true"/>
        <server name="SANCTUM_STATEFUL_DOMAINS" value="app.shp.localhost" force="true"/>
        <server name="TENANCY_SINGLE_TENANT" value="" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="REALTIME_ENABLED" value="false" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="HEALTH_CACHE_STORE" value="array" force="true"/>
        <server name="HEALTH_TOKEN" value="" force="true"/>
        <server name="FILESYSTEM_DISK" value="local" force="true"/>
        <server name="LOG_CHANNEL" value="null" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_DATABASE" value="helpdesk_test" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
