includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Level 5 in milestone 1, raised to 6 from milestone 2 (docs/10-quality/code-quality.md).
    level: 5
    paths:
        - app
        - config
        - routes
        - database
    tmpDir: storage/framework/phpstan
    ignoreErrors:
        # TenantAwareJob is used by the first queued jobs (M1-16 onward); remove this entry then.
        -
            identifier: trait.unused
            reportUnmatched: false
