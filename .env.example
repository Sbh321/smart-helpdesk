# Compose-level settings for a development workstation. Application settings: backend/.env.
COMPOSE_PROJECT_NAME=smart-helpdesk
COMPOSE_PROFILES=dev,storage
PLATFORM_DOMAIN=shp.localhost
HOST_LAYOUT=split
TLS_MODE=internal
APP_SERVE=static
PUID=1000
PGID=1000
# Host ports (80 is often taken by a local web server).
HTTP_PORT=8081
HTTPS_PORT=443
DEV_DB_PORT=55439
DEV_VALKEY_PORT=56379
# Realtime (M3-16, profile `realtime`; docs/09-infrastructure/local-development.md §Realtime). To turn it
# on, add `realtime` to COMPOSE_PROFILES and set REALTIME_ENABLED=true and BROADCAST_CONNECTION=reverb,
# then `docker compose up -d`. REVERB_APP_KEY is public and must match REVERB_APP_KEY in backend/.env.
REALTIME_ENABLED=false
BROADCAST_CONNECTION=log
REVERB_APP_KEY=shp-dev-key
# Object storage credentials for the bundled RustFS (must match AWS_* in backend/.env).
STORAGE_ACCESS_KEY=helpdesk
STORAGE_SECRET_KEY=helpdesk-secret
VALKEY_PASSWORD=
# Bundled mail server (profile `mail`, `just mail-init`; docs/09-infrastructure/docker.md §Mail). Laravel
# keeps sending to Mailpit; Stalwart relays its outbound mail to Mailpit, so DKIM-signed messages show up there.
MAIL_ADMIN_PASSWORD=dev-mail-admin
MAIL_APP_PASSWORD=dev-mail-app
MAIL_INBOUND_PASSWORD=dev-mail-inbound
MAIL_RELAY_HOST=mailpit
MAIL_RELAY_PORT=1025
# webhook-echo (dev profile): the secret shown once when you subscribe http://webhook-echo:9100/hook;
# empty: the secret of the demo seed's subscriptions (DEMO_WEBHOOK_SECRET), so `just demo-reset` needs nothing here.
WEBHOOK_ECHO_SECRET=
# Base images. If Docker Hub rate-limits anonymous pulls, use the AWS public mirror, e.g.
# NODE_IMAGE=public.ecr.aws/docker/library/node:24-alpine
# POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:18-trixie
# VALKEY_IMAGE=public.ecr.aws/valkey/valkey:9-alpine
