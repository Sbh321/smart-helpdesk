# Compose-level settings for a development workstation. Application settings: backend/.env.
COMPOSE_PROJECT_NAME=smart-helpdesk
COMPOSE_PROFILES=dev,storage
PLATFORM_DOMAIN=shp.localhost
HOST_LAYOUT=split
TLS_MODE=internal
APP_SERVE=static
PUID=1000
PGID=1000
# Host ports (80 is often taken by a local web server).
HTTP_PORT=8081
HTTPS_PORT=443
DEV_DB_PORT=55439
DEV_VALKEY_PORT=56379
# Object storage credentials for the bundled RustFS (must match AWS_* in backend/.env).
STORAGE_ACCESS_KEY=helpdesk
STORAGE_SECRET_KEY=helpdesk-secret
VALKEY_PASSWORD=
# webhook-echo (dev profile): the secret shown once when you subscribe http://webhook-echo:9100/hook.
WEBHOOK_ECHO_SECRET=
# Base images. If Docker Hub rate-limits anonymous pulls, use the AWS public mirror, e.g.
# NODE_IMAGE=public.ecr.aws/docker/library/node:24-alpine
# POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:18-trixie
# VALKEY_IMAGE=public.ecr.aws/valkey/valkey:9-alpine
