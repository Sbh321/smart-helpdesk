{
  "name": "@smart-helpdesk/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run --project unit",
    "tokens:check": "node --experimental-strip-types scripts/check-contrast.ts",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest --project unit",
    "e2e": "playwright test",
    "api:types": "pnpm dlx --package=openapi-typescript@7.13.0 --package=typescript@5.9.3 openapi-typescript ../backend/openapi.json --empty-objects-unknown -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@date-fns/tz": "^1.5.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.1",
    "@vitest/browser-playwright": "^5.0.1",
    "axe-core": "4.13.0",
    "msw": "^2.15.0",
    "oxc-transform-react": "~0.145.0",
    "playwright": "^1.63.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vitest-browser-react": "^2.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
