# Edge proxy for the split host layout (ADR-0021, docs/09-infrastructure/docker.md).
# Environment: PLATFORM_DOMAIN, TLS_MODE (acme|on_demand|internal|files), APP_SERVE (static|vite), MONITOR_AUTH (off|on).
{
	servers {
		protocols h1 h2 h3
	}
	# TLS_MODE=on_demand: a certificate is requested at the first handshake for a host name, and only
	# when the ask endpoint answers 200. The default endpoint below (inside this container) allows
	# exactly the fixed platform hosts, so a stray DNS name cannot make Caddy request certificates.
	# MVP-SHORTCUT: the backend has no ask endpoint, so tenant custom domains cannot be approved;
	# V1: V1-PL-10 (custom tenant domains) points TLS_ASK_URL at an app route backed by a domains table.
	on_demand_tls {
		ask {$TLS_ASK_URL:http://127.0.0.1:5555/tls-ask}
	}
}

# Ask endpoint for on-demand TLS (loopback inside the container, never published).
http://127.0.0.1:5555 {
	@allowed expression `{query.domain} in ["{$PLATFORM_DOMAIN}", "app.{$PLATFORM_DOMAIN}", "api.{$PLATFORM_DOMAIN}", "admin.{$PLATFORM_DOMAIN}", "monitor.{$PLATFORM_DOMAIN}", "docs.{$PLATFORM_DOMAIN}", "files.{$PLATFORM_DOMAIN}", "mail.{$PLATFORM_DOMAIN}"]`
	respond @allowed 200
	respond 403
}

(tls_acme) {
}
(tls_internal) {
	tls internal
}
(tls_files) {
	tls /certs/fullchain.pem /certs/privkey.pem
}
(tls_on_demand) {
	tls {
		on_demand
	}
}

(common) {
	encode zstd gzip
	# Correlation id for logs, problem details and audit rows (docs/11-operations/logs.md). Client values are replaced.
	request_header X-Request-Id {http.request.uuid}
	log {
		output stdout
		format json
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	import tls_{$TLS_MODE:acme}
}

# SPA from the built bundle, or the Vite dev server on the host (HMR) when APP_SERVE=vite.
(spa_static) {
	root * /srv/app
	try_files {path} /index.html
	file_server
}
(spa_vite) {
	reverse_proxy {$VITE_UPSTREAM:host.docker.internal:5173}
}

(monitor_auth_off) {
}
(monitor_auth_on) {
	basic_auth {
		{$MONITOR_USER} {$MONITOR_PASSWORD_HASH}
	}
}

{$PLATFORM_DOMAIN} {
	import common
	handle /go/app {
		redir https://app.{$PLATFORM_DOMAIN}/ 302
	}
	handle /go/docs {
		redir https://docs.{$PLATFORM_DOMAIN}/ 302
	}
	handle {
		root * /srv/landing
		file_server
	}
}

app.{$PLATFORM_DOMAIN} {
	import common
	header X-Frame-Options DENY
	handle /config.json {
		root * /srv/runtime/tenant
		file_server
	}
	handle {
		import spa_{$APP_SERVE:static}
	}
}

api.{$PLATFORM_DOMAIN} {
	import common
	# Reverb WebSocket (profile `realtime`, M3-16). Only /app (the socket): the app publishes to Reverb's
	# /apps HTTP API on the internal network, so that API is never exposed.
	@realtime path /app/*
	handle @realtime {
		reverse_proxy reverb:8080
	}
	handle {
		reverse_proxy app:8080
	}
}

admin.{$PLATFORM_DOMAIN} {
	import common
	header X-Frame-Options DENY
	handle /platform-api/* {
		reverse_proxy app:8080
	}
	handle /config.json {
		root * /srv/runtime/platform
		file_server
	}
	handle {
		import spa_{$APP_SERVE:static}
	}
}

monitor.{$PLATFORM_DOMAIN} {
	import common
	import monitor_auth_{$MONITOR_AUTH:on}
	# RustFS console uses absolute /rustfs/... paths, so the prefix is kept, not stripped.
	redir /storage /rustfs/console/
	redir /storage/ /rustfs/console/
	handle /rustfs/* {
		reverse_proxy rustfs:9001
	}
	handle_path /mail/* {
		reverse_proxy {$MAIL_ADMIN_UPSTREAM:mail:8080}
	}
	handle {
		reverse_proxy app:8080
	}
}

docs.{$PLATFORM_DOMAIN} {
	import common
	handle /openapi.json {
		rewrite * /docs/api.json
		reverse_proxy app:8080
	}
	handle {
		rewrite * /docs/api
		reverse_proxy app:8080
	}
}

files.{$PLATFORM_DOMAIN} {
	import common
	reverse_proxy rustfs:9000
}

mail.{$PLATFORM_DOMAIN} {
	import common
	reverse_proxy {$MAIL_WEB_UPSTREAM:mail:8080}
}
