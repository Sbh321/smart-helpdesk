# cp terraform.tfvars.example terraform.tfvars   (gitignored)
# AWS credentials come from the CLI session (aws login / AWS_PROFILE); Cloudflare from CLOUDFLARE_API_TOKEN;
# state_passphrase from TF_VAR_state_passphrase (never in this file).
operator_ssh_public_key = "ssh-ed25519 AAAA… you@laptop"
deploy_ssh_public_key   = "ssh-ed25519 AAAA… you@laptop"
ssh_cidrs               = ["203.0.113.7/32"]
region                  = "ap-south-1"
size                    = "t3.medium"
platform_domain         = "shp.subhambhandari.com.np"
# SES sandbox: the addresses you may send to before production access (each gets a verification link)
ses_verified_recipients = ["you@example.com"]
# After the first mail-init.sh run on the server: the selector and key it prints
# stalwart_dkim_selector   = "v1-rsa-…"
# stalwart_dkim_public_key = "MIIBIjANBg…"
# Brevo as SMTP relay (optional): the value after "brevo-code:" in Brevo's domain records
# brevo = { code = "…" }
