# Shared secrets that must live in git, encrypted with ansible-vault (none are required by default).
#   cp group_vars/all/vault.yml.example group_vars/all/vault.yml
#   ansible-vault encrypt group_vars/all/vault.yml          # asks for the vault password
#   ansible-vault edit group_vars/all/vault.yml
#   ansible-playbook site.yml --ask-vault-pass               # or --vault-password-file .vault-pass (gitignored)
# Per-host generated secrets (DB, Valkey, S3, APP_KEY, health token) are NOT here: they live in
# host_vars/<host>.secrets.yml, created on the first run and kept in the operator's password manager.
vault_registry_password: ""        # GHCR token with read:packages, if the images are private
vault_mail_password: ""            # SMTP relay password
vault_s3_key: ""                   # external S3 bucket (storage_profile=false) when not from OpenTofu
vault_s3_secret: ""
