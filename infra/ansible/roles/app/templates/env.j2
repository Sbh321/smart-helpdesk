# {{ ansible_managed }}
# Smart Helpdesk production environment; reference: infra/env/*.env.example. Mode 0600.
{% set single = host_layout == 'single' %}
{% set app_origin = 'https://' + platform_domain if single else 'https://app.' + platform_domain %}
{% set files_base = 'https://' + platform_domain + '/files' if single else 'https://files.' + platform_domain %}
{% set s3_key_value = s3_key | default(vault_s3_key | default('')) if not storage_profile | bool else app_secrets.s3_key %}
{% set s3_secret_value = s3_secret | default(vault_s3_secret | default('')) if not storage_profile | bool else app_secrets.s3_secret %}

# ---- Compose ----
COMPOSE_PROJECT_NAME=smart-helpdesk
COMPOSE_FILE={{ app_compose_files | join(':') }}
COMPOSE_PROFILES={{ ((['storage'] if storage_profile | bool else []) + (['realtime'] if realtime_profile | bool else []) + (['mail'] if mail_profile | bool else [])) | join(',') }}
BACKEND_ENV_FILE=.env
BACKEND_IMAGE={{ backend_image }}
PROXY_IMAGE={{ proxy_image }}
HTTP_PORT={{ http_port }}
HTTPS_PORT={{ https_port }}

# ---- Proxy ----
PLATFORM_DOMAIN={{ platform_domain }}
HOST_LAYOUT={{ host_layout }}
TLS_MODE={{ tls_mode }}
APP_SERVE=static
REALTIME_ENABLED={{ 'true' if realtime_profile | bool else 'false' }}
MONITOR_USER={{ monitor_user }}
MONITOR_PASSWORD_HASH='{{ app_secrets.monitor_password_hash }}'
MAIL_WEB_UPSTREAM=mail:8080
MAIL_ADMIN_UPSTREAM=mail:8080
STORAGE_ACCESS_KEY={{ app_secrets.s3_key }}
STORAGE_SECRET_KEY={{ app_secrets.s3_secret }}
VALKEY_PASSWORD={{ app_secrets.valkey_password }}

# ---- Laravel ----
APP_NAME="Smart Helpdesk"
APP_ENV=production
APP_DEBUG=false
APP_KEY={{ app_secrets.app_key }}
APP_URL={{ 'https://' + platform_domain + '/api' if single else 'https://api.' + platform_domain }}
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_VERSION={{ app_version }}
APP_MAINTENANCE_DRIVER=cache
TENANCY_SINGLE_TENANT={{ single_tenant | default('') }}

LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL={{ log_level }}

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=helpdesk
DB_USERNAME=helpdesk_app
DB_PASSWORD_FILE=/run/secrets/db_app_password
DB_OWNER_USERNAME=helpdesk_owner
DB_OWNER_PASSWORD_FILE=/run/secrets/db_owner_password

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_DOMAIN={{ '' if single else '.' + platform_domain }}
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=shp_session
SANCTUM_STATEFUL_DOMAINS={{ platform_domain if single else 'app.' + platform_domain }}
CORS_ALLOWED_ORIGINS={{ app_origin }}

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD={{ app_secrets.valkey_password }}
REDIS_PREFIX=shp_
CACHE_STORE=redis
CACHE_PREFIX=shp_cache_
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION={{ 'reverb' if realtime_profile | bool else 'log' }}
# Reverb (profile `realtime`, M3-16): the app publishes on the internal network; browsers reach the
# socket through the proxy (/app on the api host). The key is public (proxy config.json); the secret is not.
REVERB_APP_ID=smart-helpdesk
REVERB_APP_KEY={{ app_secrets.reverb_app_key }}
REVERB_APP_SECRET={{ app_secrets.reverb_app_secret }}
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID={{ s3_key_value }}
AWS_SECRET_ACCESS_KEY={{ s3_secret_value }}
AWS_DEFAULT_REGION={{ s3_region }}
AWS_BUCKET={{ s3_bucket }}
{% if storage_profile | bool %}
AWS_ENDPOINT=http://rustfs:9000
AWS_URL={{ files_base }}/{{ s3_bucket }}
AWS_PRESIGN_ENDPOINT={{ files_base }}
AWS_USE_PATH_STYLE_ENDPOINT=true
{% else %}
AWS_ENDPOINT={{ s3_endpoint }}
AWS_URL={{ (s3_public_url or s3_endpoint) }}/{{ s3_bucket }}
AWS_PRESIGN_ENDPOINT={{ s3_public_url or s3_endpoint }}
AWS_USE_PATH_STYLE_ENDPOINT=false
{% endif %}

{% if mail_profile | bool %}
# Bundled mail server (profile `mail`): submission as app@<domain>, configured by infra/scripts/mail-init.sh.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail
MAIL_PORT=587
MAIL_USERNAME=app@{{ platform_domain }}
MAIL_PASSWORD={{ app_secrets.mail_app_password }}
{% else %}
MAIL_MAILER={{ 'smtp' if mail_host | length > 0 else 'log' }}
MAIL_SCHEME=null
MAIL_HOST={{ mail_host }}
MAIL_PORT={{ mail_port }}
MAIL_USERNAME={{ mail_username if mail_username | length > 0 else 'null' }}
MAIL_PASSWORD={{ mail_password if mail_password | length > 0 else 'null' }}
{% endif %}
MAIL_FROM_ADDRESS={{ mail_from }}
MAIL_FROM_NAME="Smart Helpdesk"
# Stalwart (mail-init.sh): management and account passwords, smart host, DNS values for Settings → Email.
MAIL_ADMIN_PASSWORD={{ app_secrets.mail_admin_password }}
MAIL_APP_PASSWORD={{ app_secrets.mail_app_password }}
MAIL_INBOUND_PASSWORD={{ app_secrets.mail_inbound_password }}
MAIL_RELAY_HOST={{ mail_relay_host }}
MAIL_RELAY_PORT={{ mail_relay_port }}
MAIL_RELAY_USERNAME={{ mail_relay_username }}
MAIL_RELAY_PASSWORD={{ mail_relay_password }}
MAIL_RELAY_IMPLICIT_TLS={{ 'true' if mail_relay_implicit_tls | bool else 'false' }}
MAIL_SPF_INCLUDE={{ mail_spf_include }}
MAIL_DMARC_POLICY={{ mail_dmarc_policy }}
MAIL_DKIM_SELECTOR={{ mail_dkim_selector }}
MAIL_DKIM_PUBLIC_KEY={{ mail_dkim_public_key }}

WEBHOOK_DEV_ALLOWED_HOSTS=

HORIZON_DOMAIN={{ '' if single else 'monitor.' + platform_domain }}
HORIZON_PATH=horizon
TELESCOPE_ENABLED=false

HEALTH_TOKEN={{ app_secrets.health_token }}
HEALTH_NOTIFY_MAIL={{ health_notify_mail }}
HEALTH_CACHE_STORE=redis
PASSWORD_HASH_ROUNDS=12
