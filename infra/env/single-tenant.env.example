# Smart Helpdesk production environment, single-tenant on-premise install (single host layout,
# ADR-0021 §single-host mode, production.md §Single-tenant mode). Differences from
# multi-tenant.env.example are marked SINGLE.
# Copy to /opt/smart-helpdesk/.env (mode 0600, owner deploy). Ansible renders this file from
# infra/ansible/roles/app/templates/env.j2; this example is for manual installs and review.
# One file serves Compose (interpolation, profiles) and the backend containers (BACKEND_ENV_FILE=.env).
# Values marked CHANGE ME are per install; generate secrets with `openssl rand -hex 24`.

# ---- Compose ----
COMPOSE_PROJECT_NAME=smart-helpdesk
COMPOSE_FILE=compose.yaml:infra/compose/prod.yaml
# storage = RustFS on this host (omit when using a managed S3 bucket); realtime = Reverb
# `mail`: the bundled mail server; drop it to use an external SMTP provider (MAIL_HOST) instead.
COMPOSE_PROFILES=storage,mail
BACKEND_ENV_FILE=.env
BACKEND_IMAGE=ghcr.io/subham/smart-helpdesk-backend:2026.10.1
PROXY_IMAGE=ghcr.io/subham/smart-helpdesk-proxy:2026.10.1
HTTP_PORT=80
HTTPS_PORT=443

# ---- Proxy (frontend/docker/Caddyfile) ----
# SINGLE: one hostname; SPA at /, API at /api, platform admin at /admin, consoles at /monitor
PLATFORM_DOMAIN=helpdesk.corp.local
HOST_LAYOUT=single
# acme (public DNS, HTTP-01 per fixed host) | on_demand (certificate at first handshake, ask-gated)
# | files (customer certificate in ./certs) | internal (Caddy's own CA, intranet)
# SINGLE: intranet without public DNS -> internal; customer certificate -> files
TLS_MODE=internal
APP_SERVE=static
REALTIME_ENABLED=false
# Basic auth in front of monitor.<domain>; hash from `docker run --rm caddy:2.11-alpine caddy hash-password`.
# Single quotes keep the $ signs literal.
MONITOR_USER=ops
MONITOR_PASSWORD_HASH='CHANGE ME'
# Bundled mail server (profile `mail`, docker.md §Mail): web endpoints of mail.<domain> and /mail on monitor.
MAIL_WEB_UPSTREAM=mail:8080
MAIL_ADMIN_UPSTREAM=mail:8080
# RustFS (storage profile). Must equal AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY below.
STORAGE_ACCESS_KEY=CHANGE-ME-20-CHARS
STORAGE_SECRET_KEY=CHANGE-ME-40-CHARS
VALKEY_PASSWORD=CHANGE-ME

# ---- Laravel ----
APP_NAME="Smart Helpdesk"
APP_ENV=production
APP_DEBUG=false
# base64:<32 random bytes>: `echo "base64:$(openssl rand -base64 32)"`
APP_KEY=CHANGE-ME
APP_URL=https://helpdesk.corp.local/api
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_VERSION=2026.10.1
APP_MAINTENANCE_DRIVER=cache
# SINGLE: every request runs in this workspace (created by `platform:create-tenant corp ...`)
TENANCY_SINGLE_TENANT=corp

LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info

# Runtime role (RLS applies) and owner role (migrations, provisioning); passwords are Compose secrets.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=helpdesk
DB_USERNAME=helpdesk_app
DB_PASSWORD_FILE=/run/secrets/db_app_password
DB_OWNER_USERNAME=helpdesk_owner
DB_OWNER_PASSWORD_FILE=/run/secrets/db_owner_password

SESSION_DRIVER=database
SESSION_LIFETIME=720
# SINGLE: host-only cookie
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=shp_session
SANCTUM_STATEFUL_DOMAINS=helpdesk.corp.local
CORS_ALLOWED_ORIGINS=https://helpdesk.corp.local

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PORT=6379
# Same value as VALKEY_PASSWORD
REDIS_PASSWORD=CHANGE-ME
REDIS_PREFIX=shp_
CACHE_STORE=redis
CACHE_PREFIX=shp_cache_
QUEUE_CONNECTION=redis
# Realtime (M3-16): with `realtime` in COMPOSE_PROFILES set REALTIME_ENABLED=true (above) and
# BROADCAST_CONNECTION=reverb; generate the key and secret once (e.g. `openssl rand -hex 20`).
BROADCAST_CONNECTION=log
REVERB_APP_ID=smart-helpdesk
REVERB_APP_KEY=change-me-public-key
REVERB_APP_SECRET=change-me
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Object storage: RustFS on this host. For a managed bucket (Spaces, S3, R2, GCS interop) drop the
# storage profile, set AWS_ENDPOINT to the provider endpoint and AWS_USE_PATH_STYLE_ENDPOINT=false.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=CHANGE-ME-20-CHARS
AWS_SECRET_ACCESS_KEY=CHANGE-ME-40-CHARS
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=helpdesk
AWS_ENDPOINT=http://rustfs:9000
# SINGLE: the proxy strips /files, which breaks presigned signatures (docker.md §Environment and secrets);
# MVP-SHORTCUT: uploads/downloads through presigned URLs need a separate files host on single-host installs;
# V1: V1-PL-15. Point a second DNS name at the host if uploads matter.
AWS_URL=https://helpdesk.corp.local/files/helpdesk
AWS_PRESIGN_ENDPOINT=https://helpdesk.corp.local/files
AWS_USE_PATH_STYLE_ENDPOINT=true

# Mail (production.md §Mail). Bundled Stalwart (profile `mail`): Laravel submits to mail:587 as app@<domain>;
# run ./infra/scripts/mail-init.sh once after `up` (it prints the DNS records and the two MAIL_DKIM_* lines).
# Without the mail profile, point MAIL_HOST/PORT/USERNAME/PASSWORD at any SMTP provider instead.
# `log` never sends; a half-configured install therefore never spams.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail
MAIL_PORT=587
MAIL_USERNAME=app@helpdesk.corp.local
MAIL_PASSWORD=CHANGE-ME-same-as-MAIL_APP_PASSWORD
MAIL_FROM_ADDRESS=helpdesk@corp.local
MAIL_FROM_NAME="Smart Helpdesk"
# Stalwart (read by mail-init.sh, not by Laravel): management and account passwords (A-Z a-z 0-9 . _ ~ @ + / = -).
MAIL_ADMIN_PASSWORD=CHANGE-ME
MAIL_APP_PASSWORD=CHANGE-ME
MAIL_INBOUND_PASSWORD=CHANGE-ME
MAIL_INBOUND_ENABLED=false               # true with the bundled mail server (COMPOSE_PROFILES incl. mail)
# Smart host when outbound port 25 is blocked (AWS, GCP): e.g. Amazon SES, runbooks.md §Outbound mail.
MAIL_RELAY_HOST=
MAIL_RELAY_PORT=587
MAIL_RELAY_USERNAME=
MAIL_RELAY_PASSWORD=
MAIL_RELAY_IMPLICIT_TLS=false
# DNS values shown in Settings → Email; the DKIM pair comes from the mail-init.sh output.
MAIL_SPF_INCLUDE=
MAIL_DMARC_POLICY=none
MAIL_DKIM_SELECTOR=
MAIL_DKIM_PUBLIC_KEY=

WEBHOOK_DEV_ALLOWED_HOSTS=

# SINGLE: no dedicated monitor host; Horizon answers under /monitor/horizon
HORIZON_DOMAIN=
HORIZON_PATH=horizon
# Queue workers: auto-balanced up to 10 (default); a 2 GB demo host uses false / 2 / 1 (production.md §Sizing)
HORIZON_BALANCE=auto
HORIZON_MAX_PROCESSES=10
HORIZON_WEBHOOK_PROCESSES=4
TELESCOPE_ENABLED=false

# /v1/health on the api host: Authorization: Bearer <HEALTH_TOKEN>
HEALTH_TOKEN=CHANGE-ME
HEALTH_NOTIFY_MAIL=it@corp.local
HEALTH_CACHE_STORE=redis
PASSWORD_HASH_ROUNDS=12
